{"html": "<!DOCTYPE HTML>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"/><meta content=\"default-src 'none'; script-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'\" http-equiv=\"Content-Security-Policy\"/>\n\n\n<title>Calculating your GPA |  University of North Texas</title>\n\n\n\n\n\n\n\n<style>mark[data-source-highlight] { background: #ffdf66 !important; color: #171717 !important; outline: 1px solid #b68a00; scroll-margin: 100px; } html { overflow-wrap: break-word; }</style></head>\n<body>\n\n\n\n\n\n\n <div class=\"page-wrapper\">\n<header id=\"unt-distro-header\">\n<div class=\"skip-link\" id=\"skip\"><a class=\"element-invisible element-focusable\">Skip to main content</a></div>\n<div class=\"search-dropdown\" id=\"searchdropdown\" style=\"display: none; margin-top: 0;\"><div class=\"search-dropdown-wrapper\">\n<div class=\"close-toggle\">\n<div class=\"search-toggle-close close-btn\" id=\"search-toggle-close-btn\" type=\"button\">\n\t\t\tclose\n\t\t\t\n</div>\n</div>\n<div class=\"search-dropdown-funnelback\">\n<div class=\"search-container\">\n<label class=\"hidden\">Search...</label>\n\n<div class=\"funnelback-search-button\" role=\"button\"><span class=\"fas fa-search\"></span> <span class=\"hidden\">Search</span></div>\n</div>\n<fieldset class=\"search-radios\">\n<legend class=\"hidden\">Search Options</legend>\n<div class=\"radio\">\n<div class=\"radio-wrapper\"> <label class=\"radio-label\">Search This Site</label></div>\n</div>\n<div class=\"radio pl-6\">\n<div class=\"radio-wrapper\"> <label class=\"radio-label\">Search All of UNT</label></div>\n</div>\n</fieldset>\n</div>\n</div></div>\n<div class=\"topbar\"><div class=\"topbar-wrapper\">\n<div class=\"topbar-link\"><a><span>Up Left Arrow Box icon</span>University of North Texas </a></div>\n<div class=\"topbar-quicklinks\">\n<div class=\"topbar-quicklinks-wrapper\"><a class=\"quicklinks-link\"> MYUNT </a><a class=\"quicklinks-link\"> CANVAS </a><a class=\"quicklinks-link\"> STUDENT EMAIL </a><a class=\"quicklinks-link\"> UNT DIRECTORY </a></div><div class=\"search-toggle distro\" type=\"button\">\n         \t\t\t\t\t\tSEARCH\n         \t\t\t\t\t</div></div>\n</div></div>\n<div class=\"header-distro\">\n<div class=\"header-wrapper\">\n<div class=\"brand-wrapper\">\n<div class=\"branding\"><div class=\"unt-logo\">\n<a title=\"Click to go to the [SITENAME HERE] home page\">\n<span>UNT Diving Eagle logo</span></a>\n<a title=\"Click to go to the UNT home page\">\n<span>UNT Diving Eagle logo</span>\n</a>\n</div> <div class=\"sitename\"><a class=\"sitename-department\" title=\"Student Success\">Student Success</a><a class=\"sitename-primary\" title=\"Advising\">Advising</a></div>\n</div>\n</div>\n<div class=\"main-menu-wrapper\">\n<div class=\"main-menu-shim\"> </div>\n<ul class=\"main-menu inline-block\">\n<li class=\"main-menu-link has-dropdown self-end\"><a>Academic Advising</a><ul class=\"main-menu-subnav block\">\n<li class=\"hidden\"><a class=\"subnav-item backLink\">Back</a></li>\n<li class=\"hidden\"><a class=\"subnav-item parentLink\">Academic Advising</a></li>\n<li>\n<ul>\n<li><a class=\"subnav-item\">Specialized Advising</a></li>\n<li><a class=\"subnav-item\">How Can My Advisor Help?</a></li>\n<li><a class=\"subnav-item\">Advising FAQs</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li class=\"main-menu-link self-end\"><a>Advising Guidebook</a></li>\n<li class=\"main-menu-link has-dropdown self-end\"><a>Build Your Degree</a><ul class=\"main-menu-subnav block\">\n<li class=\"hidden\"><a class=\"subnav-item backLink\">Back</a></li>\n<li class=\"hidden\"><a class=\"subnav-item parentLink\">Build Your Degree</a></li>\n<li>\n<ul>\n<li><a class=\"subnav-item\">Choosing A Major</a></li>\n<li><a class=\"subnav-item\">About Your Degree</a></li>\n<li><a class=\"subnav-item\">Types of Degrees</a></li>\n<li><a class=\"subnav-item\">University Core</a></li>\n<li><a class=\"subnav-item\">UNT Requi