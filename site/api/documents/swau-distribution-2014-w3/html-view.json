{"html": "<!DOCTYPE html\n\tPUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\">\n\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"/><meta content=\"default-src 'none'; script-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'\" http-equiv=\"Content-Security-Policy\"/>\n\n\n\n\n\n<title>SWAU: Distribution of Aid</title>\n\n\n\n\n<style>mark[data-source-highlight] { background: #ffdf66 !important; color: #171717 !important; outline: 1px solid #b68a00; scroll-margin: 100px; } html { overflow-wrap: break-word; }</style></head>\n<body>\n<div id=\"wrapper-content-slider\">\n<div id=\"header\">\n<div id=\"logo\">\n<a>\n<span></span>\n<span></span>\n</a>\n</div>\n<div id=\"head-menu-1\"><table width=\"100%\"><tr><td><a><span data-source-end=\"11\" data-source-start=\"0\">Prospective</span><br/><span data-source-end=\"20\" data-source-start=\"12\">Students</span></a></td><td><span></span></td><td><a><span data-source-end=\"28\" data-source-start=\"21\">Current</span><br/><span data-source-end=\"37\" data-source-start=\"29\">Students</span></a></td><td><span></span></td><td><a><span data-source-end=\"45\" data-source-start=\"38\">Parents</span></a></td><td><span></span></td><td><a><span data-source-end=\"52\" data-source-start=\"46\">Alumni</span><br/><span data-source-end=\"54\" data-source-start=\"53\">&amp;</span><br/><span data-source-end=\"62\" data-source-start=\"55\">Friends</span></a></td><td><span></span></td><td><a><span data-source-end=\"70\" data-source-start=\"63\">Faculty</span><br/><span data-source-end=\"72\" data-source-start=\"71\">&amp;</span><br/><span data-source-end=\"78\" data-source-start=\"73\">Staff</span></a> </td><td> </td></tr></table></div>\n<div id=\"head-menu-2\"><table width=\"100%\"><tr><td><a><span data-source-end=\"86\" data-source-start=\"79\">Request</span><br/><span data-source-end=\"98\" data-source-start=\"87\">Information</span></a></td><td><span></span></td><td><a><span data-source-end=\"108\" data-source-start=\"99\">Visit Our</span><br/><span data-source-end=\"115\" data-source-start=\"109\">Campus</span></a></td><td><span></span></td><td><a><span data-source-end=\"121\" data-source-start=\"116\">Apply</span><br/><span data-source-end=\"125\" data-source-start=\"122\">Now</span></a> </td><td> </td></tr></table></div>\n</div>\n<div id=\"main\">\n<div id=\"container\">\n\n\n<div class=\"csc-default\" id=\"c303\"><div id=\"slider-wrapper\">\n<div class=\"nivoSlider\" id=\"slider\">\n<span></span>\n<span></span>\n<span></span>\n</div>\n<div class=\"nivo-html-caption\" id=\"htmlcaption1\">\n<h4><span data-source-end=\"150\" data-source-start=\"126\">Learning, Doing, Growing</span></h4>\n<p><span data-source-end=\"256\" data-source-start=\"151\">Southwestern Adventist University believes in the development of the whole person: body, mind and spirit.</span></p>\n</div>\n<div class=\"nivo-html-caption\" id=\"htmlcaption2\">\n<h4><span data-source-end=\"277\" data-source-start=\"257\">Opportunities Abound</span></h4>\n<p><span data-source-end=\"474\" data-source-start=\"278\">We are more concerned with the quality of our many small programs than the development of bigger ones. As such, the educational focus is personal, and students have many opportunities to flourish.</span></p>\n</div>\n<div class=\"nivo-html-caption\" id=\"htmlcaption3\">\n<h4><span data-source-end=\"498\" data-source-start=\"475\">An International Flavor</span></h4>\n<p><p class=\"bodytext\"><span data-source-end=\"669\" data-source-start=\"499\">With students from more than two dozen countries, Southwestern offers the young person an opportunity to meet and interact while learning how the rest of the world lives.</span></p></p>\n</div>\n<div class=\"nivo-html-caption\" id=\"htmlcaption4\">\n<h4></h4>\n<p></p>\n</div>\n<div class=\"nivo-html-caption\" id=\"htmlcaption5\">\n<h4></h4>\n<p></p>\n</div>\n<div class=\"nivo-html-caption\" id=\"htmlcaption6\">\n<h4></h4>\n<p></p>\n</div>\n\n\n</div></div>\n\n\n<div id=\"title-text\"><span data-source-end=\"683\" data-source-start=\"670\">Financial Aid</span></div>\n<div id=\"sub-container\">\n<div id=\"left-bar-content-slider\">\n<div id=\"page-menu\"><ul><li><a><span data-source-end=\"699\" data-source-start=\"684\">2013-2014 Forms</span></a></li><li><a><span data-source-end=\"715\" data-source-start=\"700\">2014-2015 Forms</span></a></li><li class=\"current_page_item\"><a><span data-source-end=\"735\" data-source-start=\"716\">Distribution of Aid</span></a></li><li><a><span data-source-end=\"742\" data-source-start=\"736\">Grants</span></a></li><li><a><span data-source-end=\"755\" data-source-start=\"743\">Scholarships</span></a></li><li><a><span data-source-end=\"766\" data-source-start=\"756\">Work Study</span></a></li><li><a><span data-source-end=\"772\" data-source-start=\"767\">Loans</span></a></li><li><a><span data-source-end=\"803\" data-source-start=\"773\">Satisfactory Academic Progress</span></a></li><li><a><span data-source-end=\"812\" data-source-start=\"804\">Veterans</span></a></li><li><a><span data-source-end=\"829\" data-source-start=\"813\">Study Abroad Aid</span></a></li><li><a><span data-source-end=\"843\" data-source-start=\"830\">Refund Policy</span></a></li><li><a><span data-source-end=\"865\" data-source-start=\"844\">Special Circumstances</span></a></li></ul></div>\n<div id=\"left-bar-content\"></div>\n</div>\n<div id=\"content-slider\">\n<div id=\"content\">\n\n<div class=\"csc-default\" id=\"c726\">\n\n<div class=\"csc-header csc-header-n1\"><h1 class=\"csc-firstHeader\"><span data-source-end=\"885\" data-source-start=\"866\">Distribution of Aid</span></h1></div>\n\n\n<p class=\"bodytext\"><b><span data-source-end=\"1045\" data-source-start=\"886\">Students who apply for federal/state aid are automatically considered for all available scholarships, grants, and other “gift” aid for which they are eligible.</span></b>  \r</p>\n<p class=\"bodytext\"><span data-source-end=\"1312\" data-source-start=\"1046\">Students who indicate that they will be working on campus will be considered for the federal/state work study programs. Students who submit their FAFSA before the application priority date of March 15 will receive the maximum grant money for which they are eligible.</span> </p>\n\n</div>\n\n</div>\n</div>\n</div>\n</div>\n<div id=\"right-bar\">\n<div id=\"main-menu\"><ul><li class=\"menuItem\"><a><span data-source-end=\"1321\" data-source-start=\"1313\">About Us</span></a></li><li class=\"menuItem\"><a><span data-source-end=\"1331\" data-source-start=\"1322\">Academics</span></a></li><li class=\"menuItem\"><a><span data-source-end=\"1352\" data-source-start=\"1332\">Bulletin Information</span></a></li><li class=\"menuItem\"><a><span data-source-end=\"1364\" data-source-start=\"1353\">Campus Life</span></a></li><li class=\"menuItem\"><a><span data-source-end=\"1375\" data-source-start=\"1365\">Enrollment</span></a></li><li class=\"current_page_item\"><a><span data-source-end=\"1384\" data-source-start=\"1376\">Finances</span></a></li><ul><li class=\"subMenuItem\"><span></span> <a><span data-source-end=\"1414\" data-source-start=\"1385\">Estimated Costs for 2013-2014</span></a></li><li class=\"subMenuItem\"><span></span> <a><span data-source-end=\"1444\" data-source-start=\"1415\">Estimated Costs for 2014-2015</span></a></li><li class=\"subMenuItem\"><span></span> <a><span data-source-end=\"1458\" data-source-start=\"1445\">Financial Aid</span></a></li><li class=\"subMenuItem\"><span></span> <a><span data-source-end=\"1475\" data-source-start=\"1459\">Student Accounts</span></a></li><li class=\"subMenuItem\"><span></span> <a><span data-source-end=\"1496\" data-source-start=\"1476\">Net Price Calculator</span></a></li><li class=\"subMenuItem\"><span></span> <a><span data-source-end=\"1513\" data-source-start=\"1497\">Department Staff</span></a></li></ul><li class=\"menuItem\"><a><span data-source-end=\"1518\" da