{"html": "\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n\n<html>\n<head><meta charset=\"utf-8\"/><meta content=\"default-src 'none'; script-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'\" http-equiv=\"Content-Security-Policy\"/><title>\r\n\tTexas B-On-Time Loan\r\n</title><style>mark[data-source-highlight] { background: #ffdf66 !important; color: #171717 !important; outline: 1px solid #b68a00; scroll-margin: 100px; } html { overflow-wrap: break-word; }</style></head>\n<body>\n<div id=\"aspnetForm\">\n\n\n\n\n\n<div id=\"background\">\n<div id=\"prepage\">\n<center>\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"910\">\n<tbody>\n<tr>\n<td align=\"right\" class=\"TopLinks\"><a><span data-source-end=\"18\" data-source-start=\"0\">Financial Aid Home</span></a> <span data-source-end=\"20\" data-source-start=\"19\">|</span> <a><span data-source-end=\"29\" data-source-start=\"21\">Calendar</span></a> <span data-source-end=\"31\" data-source-start=\"30\">|</span> <a><span data-source-end=\"37\" data-source-start=\"32\">Forms</span></a> <span data-source-end=\"39\" data-source-start=\"38\">|</span> <a><span data-source-end=\"50\" data-source-start=\"40\">Contact Us</span></a> <span data-source-end=\"52\" data-source-start=\"51\">|</span> <a><span data-source-end=\"57\" data-source-start=\"53\">TAMU</span></a> <span data-source-end=\"59\" data-source-start=\"58\">|</span> <a><span data-source-end=\"73\" data-source-start=\"60\">Aggie Answers</span></a> </td>\n</tr>\n</tbody>\n</table>\n</center>\n</div>\n<table align=\"center\" width=\"910px\">\n<tr>\n<td>\n<div id=\"Shadow\" style=\"width:910px;padding:10px;filter:shadow(color:grey, Direction:135, strength:10);\">\n<div id=\"page\">\n<div id=\"header\">\n<a><span>Scholarships and Financial Aid</span></a>\n<div>\n<div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_wrapper\">\n<div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_Div\" style=\"overflow:hidden;position:relative;height:234px;width:910px;\"><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_FrameContainer\" style=\"position:relative;width:910px;\"><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame0\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame1\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame2\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame3\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame4\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame5\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame6\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame7\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame8\" style=\"overflow:hidden;\"><span></span></div><div id=\"ctl00_cphTopRotatingGraphic_ctl00_RadRotator1_frame9\" style=\"overflow:hidden;\"><span></span></div></div></div>\n</div>\n</div>\n</div>\n<div id=\"searchbar\">\n<fieldset class=\"sf_searchBox\">\n<table><tr><td valign=\"middle\">\n<span class=\"barbuttons\"><a><span data-source-end=\"94\" data-source-start=\"74\">PROSPECTIVE STUDENTS</span></a>  <span data-source-end=\"96\" data-source-start=\"95\">|</span>   <a><span data-source-end=\"113\" data-source-start=\"97\">CURRENT STUDENTS</span></a>  <span data-source-end=\"115\" data-source-start=\"114\">|</span>   <a><span data-source-end=\"124\" data-source-start=\"116\">GRADUATE</span></a>  <span data-source-end=\"126\" data-source-start=\"125\">|</span>   <a><span data-source-end=\"140\" data-source-start=\"127\">INTERNATIONAL</span></a>  <span data-source-end=\"142\" data-source-start=\"141\">|</span>   <a><span data-source-end=\"159\" data-source-start=\"143\">STUDENT ATHLETES</span></a>        </span>          \r\n    </td></tr></table>\n</fieldset>\n</div>\n<div id=\"pagebody\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#5F574F;\" width=\"910px\">\n<tr>\n<td height=\"600px\" style=\"background-color: #5F574F\" valign=\"top\" width=\"250px\">\n<div class=\"panelbar RadPanelbar_Default styles.css\" id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1\">\n<span id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1StyleSheetHolder\" style=\"display:none;\"></span><ul class=\"rootGroup\">\n<li class=\"item first\"><a class=\"link expandable\" id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1_p0\"><span class=\"text\"><span data-source-end=\"180\" data-source-start=\"160\">Financial Aid Basics</span></span></a><div class=\"slide\">\n<ul class=\"group level1\">\n<li class=\"item first\"><a class=\"link\" id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1_p0_p0\"><span class=\"text\"><span data-source-end=\"207\" data-source-start=\"181\">Determining Financial Need</span></span></a></li><li class=\"item\"><a class=\"link\" id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1_p0_p1\"><span class=\"text\"><span data-source-end=\"231\" data-source-start=\"208\">College Cost Calculator</span></span></a></li><li class=\"item\"><a class=\"link\" id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1_p0_p2\"><span class=\"text\"><span data-source-end=\"249\" data-source-start=\"232\">Dependency Status</span></span></a></li><li class=\"item\"><a class=\"link\" id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1_p0_p3\"><span class=\"text\"><span data-source-end=\"275\" data-source-start=\"250\">Extenuating Circumstances</span></span></a></li><li class=\"item\"><a class=\"link\" id=\"ctl00_cphLeftNavBar_ctl00_RadPanelbar1_p0_p4\"><span class=\"t