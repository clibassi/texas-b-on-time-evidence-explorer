{"html": "<!DOCTYPE html>\n\n\n\n\n <html class=\"no-js\" dir=\"ltr\" lang=\"en\"> \n<head><meta charset=\"utf-8\"/><meta content=\"default-src 'none'; script-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'\" http-equiv=\"Content-Security-Policy\"/>\n\n\n\n\n\n\n\n\n<title>Texas B-On-Time Loan | Student Financial Aid and Scholarships</title>\n\n\n\n<style>\n\n\n\n</style>\n<style>\n\n\n\n\n\n\n\n\n\n\n\n</style>\n<style>\n\n\n</style>\n<style>\n\n\n\n</style>\n\n\n<style>\r\n/* Sidebar menu adjustments */\r\n.block.block-menu-block h2.block-title a {\r\n    color: #fff;\r\n}\r\n.menu-block-1 li.leaf.active-trail.active a {\r\n    background-color: #ccc;\r\n    box-shadow: none;\r\n    color: #333;\r\n}\r\n\r\n/* Top navigation menu */\r\ndiv.main-menu ul.menu li ul.menu li a.active, div.main-menu ul.menu li ul.menu li a.active-trail {\r\n    background-color: #ccc;\r\n}\r\n\r\n/* Buttons */\r\na.button {\r\n    color: #fff;\r\n    border-radius: 5px;\r\n    background: linear-gradient(#1ca45c, #00853e);\r\n}\r\na:hover.button {\r\n    color: #eee;\r\n}\r\n.btn.btn1.white a { color: #fff; border-color: #fff; }\r\n.btn.btn1.white a:hover { color: #00853e; border-color: #fff; background-color: #fff; }\r\n\r\n/* Upcoming events */\r\n.view-upcoming-events {\r\nmargin-bottom: 4rem;\r\n}\r\n.view-upcoming-events .columns.medium-6 {\r\nmin-height: 250px;\r\n}\r\n</style>\n<style type=\"text/css\">\r\n/* remove spacing from page titles \r\n#page-title {\r\n    margin: 0 0 0 0 !important;\r\n}\r\n*/\r\n\r\n/* add toggle icons */\r\n\r\n.custom-accordion .accordion-navigation>a:before,\r\n.faq-accordion .accordion-navigation>a:before {\r\n    float: left !important;\r\n    font-family: FontAwesome;\r\n    content: \"\\f0fe\";\r\n    padding-right: 5px;\r\n}\r\n\r\n.custom-accordion dd.active>a:before,\r\n.faq-accordion dd.active>a:before {\r\n    float: left !important;\r\n    content: \"\\f146\";\r\n}\r\n\r\n\r\n/* change backgrounds to white */\r\n\r\n.custom-accordion .accordion-navigation>a,\r\n.custom-accordion .accordion dd>a,\r\n.custom-accordion .accordion-navigation.active>a {\r\n    background-color: #ffffff;\r\n    color: #006a31;\r\n}\r\n\r\n.faq-accordion .accordion-navigation>a,\r\n.faq-accordion .accordion dd>a,\r\n.faq-accordion .accordion-navigation.active>a {\r\n    background-color: #ffffff;\r\n    color: #006a31;\r\n}\r\n\r\n\r\n\r\n.custom-accordion .accordion-navigation>a:hover,\r\n.custom-accordion dd>a:hover {\r\n    background-color: #ffffff;\r\n    color: #000000;\r\n}\r\n\r\n.faq-accordion .accordion-navigation>a:hover,\r\n.faq-accordion dd>a:hover {\r\n    background-color: #ffffff;\r\n    color: #000000;\r\n}\r\n\r\n.custom-accordion .accordion-navigation.active>a {\r\n    background-color: #efefef;\r\n    color: #000000;\r\n    border-bottom: 1px solid #efefef;\r\n}\r\n\r\n.faq-accordion .accordion-navigation.active>a {\r\n    background-color: #efefef;\r\n    color: #000000;\r\n    border-bottom: 1px solid #efefef;\r\n}\r\n\r\n\r\n.faq-accordion  .content.active{\r\n    border: 1px solid #efefef;\r\n}\r\n\r\n.faq-accordion .accordion-navigation > a, \r\n.faq .accordion dd > a {\r\n    margin-bottom: 0;\r\n}\r\n\r\n.custom-accordion .accordion-navigation>a,\r\n.custom-accordion dd>a {\r\n    font-size: 24px;\r\n    border-bottom: 1px dotted #cccccc;\r\n}\r\n\r\n\r\n\r\n.icon-box {\r\n    text-decoration: none;\r\n    text-align: center;\r\n}\r\n\r\n.icon-box:hover>div {\r\n    border-style: solid;\r\n    border-width: 1px;\r\n    border-color: #555555;\r\n    margin-bottom: 1.25rem;\r\n    padding: 1.25rem;\r\n    background: #d8d8d8;\r\n    color: #333333;\r\n    text-decoration: none;\r\n}\r\n\r\n.icon-box>div>H5 {\r\n    color: #00853e;\r\n}\r\n\r\n.icon-box:hover>div>H5 {\r\n    text-decoration: none;\r\n}\r\n\r\n\r\n.icon-box-green {\r\n    text-decoration: none;\r\n    text-align: center;\r\n}\r\n\r\n.icon-box-green:hover>div {\r\n    border-style: solid;\r\n    border-width: 1px;\r\n    border-color: #555555;\r\n    margin-bottom: 1.25rem;\r\n    padding: 1.25rem;\r\n    background: #d8d8d8;\r\n    color: #333333;\r\n    text-decoration: none;\r\n}\r\n\r\n.icon-box-green>div>H5 {\r\n    color: #00853e;\r\n}\r\n\r\n.icon-box-green:hover>div>H5 {\r\n    text-decoration: none;\r\n}\r\n\r\n\r\n\r\n/* fix anchors which need to be below header */\r\n.anchor{\r\n   display:block;\r\n   height:55px; /* this is the height of your header */\r\n   margin-top:-55px; /* this is again negative value of the height of your header */\r\n   visibility:hidden;\r\n}\r\n\r\n/* quick links */\r\na.quick-link {\r\n    display: block;\r\n    padding: 10px;\r\n    background-color: #00853e;\r\n    color: #fff;\r\n    margin-bottom: 10px;\r\n    width: 100%;\r\ntext-decoration: none;\r\n}\r\na.quick-link:hover {\r\nbackground-color: #006a31; color: #fff;\r\n}\r\na.quick-link:before {\r\n    font-family: \"FontAwesome\"; float: right; content: \"\\f105\";\r\n}\r\n\r\n/* adjust height for population pages */\r\nh3.population {\r\n    margin-top: 0px; \r\n}\r\n\r\n.no-bottom-margin{ margin-bottom: 0px !important; }\r\n\r\n</style>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<style>mark[data-source-highlight] { background: #ffdf66 !important; color: #171717 !important; outline: 1px solid #b68a00; scroll-margin: 100px; } html { overflow-wrap: break-word; }</style></head>\n<body class=\"html not-front not-logged-in no-sidebars page-node page-node- page-node-363 node-type-page section-bot bot\">\n<div class=\"skip-link\" id=\"skip\">\n<a class=\"element-invisible element-focusable\">Skip to main content</a>\n</div>\n<div class=\"page\" role=\"document\">\n<header class=\"l-header\" role=\"banner\">\n\n<div class=\"contain-to-grid show-for-small\">\n<nav class=\"top-bar\">\n\n<ul class=\"title-area\">\n<li class=\"name\">\n<h1><a title=\"UNT\">UNT</a></h1>\n</li>\n<li class=\"toggle-topbar menu-icon\">\n<a><span class=\"text